{
  "name": "@crm/infrastructure",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sidecar": "./src/ipc/json-rpc.server.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/ipc/json-rpc.server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun run src/persistence/drizzle/migrate.ts",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@crm/domain": "workspace:*",
    "@crm/application": "workspace:*",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@crm/typescript-config": "workspace:*",
    "drizzle-kit": "^0.30.0",
    "typescript": "~5.9.2",
    "@types/bun": "latest"
  }
}
